# Local secrets / config — never commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# Pipeline runtime state and logs
runs/
*.log

# Per-deployment operator config (set from the dashboard, not shipped)
config/agent_prompts/*.txt
config/share_posts/
config/model_overrides.json

# Downloaded PDFs / extracted text (large, regenerable from the sources)
pdfs/

# Node / website build output (see also website/.gitignore)
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
